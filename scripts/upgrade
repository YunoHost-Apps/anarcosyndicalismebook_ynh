#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

# Check PHP version availability
check_php_version

#=================================================
# INSTALL VERSIONED PHP EXTENSIONS
#=================================================
ynh_script_progression "Installing PHP $php_version extensions..."

# Install versioned PHP extensions to ensure they match the active PHP-FPM version.
for ext in zip gd sqlite3 curl mbstring xml; do
    pkg="php${php_version}-${ext}"
    if ! dpkg -l "$pkg" 2>/dev/null | grep -q '^ii'; then
        apt-get install -y --no-install-recommends "$pkg" || ynh_print_info "Could not install $pkg (may already be installed under another name)"
    fi
done

# Enable extensions in PHP-FPM and CLI
for ext in zip gd sqlite3 curl mbstring xml; do
    phpenmod -v "$php_version" "$ext" 2>/dev/null || true
done

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_setup_source --dest_dir="$install_dir" --full_replace=1

#=================================================
# UPGRADE COMPOSER DEPENDENCIES
#=================================================
ynh_script_progression "Upgrading Composer dependencies..."

# Check if composer.json exists before installing dependencies
if [[ -f "$install_dir/composer.json" ]]; then
    ynh_composer_install
    # Run composer install directly as the app user
    pushd "$install_dir"
    sudo -u "$app" php"$php_version" composer.phar install --no-dev --prefer-dist --optimize-autoloader --no-interaction
    popd
else
    ynh_print_info "No composer.json found, skipping Composer dependencies installation"
fi

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations..."

ynh_config_add_phpfpm

ynh_config_add_nginx

# Remove the installer scripts for security
rm -f "$install_dir/install.php" "$install_dir/install_app.php"

#=================================================
# ENSURE DATA DIRECTORIES EXIST
#=================================================
ynh_script_progression "Ensuring data directories exist..."

mkdir -p "$data_dir/uploads/site"
mkdir -p "$data_dir/uploads/auteurs"
mkdir -p "$data_dir/uploads/textes"
mkdir -p "$data_dir/uploads/avatars"
mkdir -p "$data_dir/uploads/.logs"
mkdir -p "$data_dir/uploads/.ratelimit"
mkdir -p "$data_dir/backups"
mkdir -p "$data_dir/logs"
mkdir -p "$data_dir/releases"

#=================================================
# RESTORE SYMLINKS
#=================================================
ynh_script_progression "Restoring symlinks..."

# Remove existing directories/links before creating symlinks
if [[ -e "$install_dir/uploads" ]]; then
    rm -rf "$install_dir/uploads"
fi
if [[ -e "$install_dir/backups" ]]; then
    rm -rf "$install_dir/backups"
fi
if [[ -e "$install_dir/logs" ]]; then
    rm -rf "$install_dir/logs"
fi
if [[ -e "$install_dir/releases" ]]; then
    rm -rf "$install_dir/releases"
fi

# Create symlinks
ln -sf "$data_dir/uploads" "$install_dir/uploads"
ln -sf "$data_dir/backups" "$install_dir/backups"
ln -sf "$data_dir/logs" "$install_dir/logs"
ln -sf "$data_dir/releases" "$install_dir/releases"

# Create temp migration directory
mkdir -p "$install_dir/api/temp_migration"
chown "$app:www-data" "$install_dir/api/temp_migration"
chmod 775 "$install_dir/api/temp_migration"

# Verify symlinks were created successfully
if [[ ! -L "$install_dir/uploads" ]] || [[ ! -L "$install_dir/backups" ]]; then
    ynh_die "Failed to create symlinks for data directories"
fi

#=================================================
# RUN DATABASE MIGRATIONS IF NEEDED
#=================================================
ynh_script_progression "Checking for database updates..."

# Check if there are any database migration scripts to run
if [[ -f "$install_dir/sql/migrations.sql" ]]; then
    ynh_print_info "Running database migrations..."
    # Harmoniser l'ancien schéma menu avant d'ajouter les nouvelles colonnes.
    # Les données sont conservées : seules les anciennes colonnes sont renommées.
    ynh_mysql_db_shell <<'EOF' || ynh_die "Unable to normalize the menu table schema"
SET @has_nomenu = (
    SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'menu' AND COLUMN_NAME = 'nomenu'
);
SET @has_id = (
    SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'menu' AND COLUMN_NAME = 'id'
);
SET @rename_id = IF(
    @has_nomenu = 1 AND @has_id = 0,
    'ALTER TABLE `menu` CHANGE COLUMN `nomenu` `id` INT(11) NOT NULL AUTO_INCREMENT',
    'SELECT 1'
);
PREPARE stmt_id FROM @rename_id;
EXECUTE stmt_id;
DEALLOCATE PREPARE stmt_id;

SET @has_actif = (
    SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'menu' AND COLUMN_NAME = 'actif'
);
SET @has_visible = (
    SELECT COUNT(*) FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'menu' AND COLUMN_NAME = 'visible'
);
SET @rename_visible = IF(
    @has_actif = 1 AND @has_visible = 0,
    'ALTER TABLE `menu` CHANGE COLUMN `actif` `visible` TINYINT(1) NOT NULL DEFAULT 1',
    'SELECT 1'
);
PREPARE stmt_visible FROM @rename_visible;
EXECUTE stmt_visible;
DEALLOCATE PREPARE stmt_visible;
EOF
    ynh_mysql_db_shell < "$install_dir/sql/migrations.sql"
fi

#=================================================
# UPDATE CONFIGURATION FILES
#=================================================
ynh_script_progression "Updating configuration files..."

load_app_settings
render_app_config

#=================================================
# SET PERMISSIONS
#=================================================
ynh_script_progression "Setting permissions..."

chown -R "$app:www-data" "$install_dir"
chmod -R 750 "$install_dir"

# Set permissions on data directories
chown -R "$app:www-data" "$data_dir"
chmod -R 750 "$data_dir"

# Set specific permissions for config files
chmod 400 "$install_dir/includes/database.php"
chown "$app:$app" "$install_dir/includes/database.php"
chmod 400 "$install_dir/includes/config.php"
chown "$app:$app" "$install_dir/includes/config.php"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Upgrade of $app completed"
