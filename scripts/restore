#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

detect_php_version || ynh_die "Unable to detect the PHP version for restore"

#=================================================
# RESTORE THE APP MAIN DIR
#=================================================
ynh_script_progression "Restoring the app main directory..."

ynh_restore "$install_dir"

chown -R "$app:www-data" "$install_dir"
chmod -R 750 "$install_dir"

#=================================================
# RESTORE THE DATA DIRECTORY
#=================================================
ynh_script_progression "Restoring the data directory..."

ynh_restore "$data_dir"

chown -R "$app:www-data" "$data_dir"
chmod -R 750 "$data_dir"

#=================================================
# RESTORE THE MYSQL DATABASE
#=================================================
ynh_script_progression "Restoring the MySQL database..."

if [[ ! -f "db.sql" ]]; then
    ynh_die "Database backup file not found: db.sql"
fi

if [[ ! -s "db.sql" ]]; then
    ynh_die "Database backup file is empty"
fi

if ! ynh_mysql_db_shell < db.sql; then
    ynh_die "Failed to restore database"
fi

#=================================================
# RESTORE SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Restoring system configurations..."

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"

ynh_restore "/etc/php/$php_version/fpm/pool.d/$app.conf"

#=================================================
# RELOAD NGINX AND PHP-FPM
#=================================================
ynh_script_progression "Reloading NGINX and PHP-FPM..."

ynh_systemctl --service="php$php_version-fpm" --action=reload
ynh_systemctl --service=nginx --action=reload

# Ensure services are running
ynh_systemctl --service="php$php_version-fpm" --action=start
ynh_systemctl --service=nginx --action=start

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Restoration of $app completed"
