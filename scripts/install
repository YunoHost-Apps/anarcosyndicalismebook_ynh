#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

# Check PHP version availability
check_php_version

#=================================================
# INSTALL VERSIONED PHP EXTENSIONS
#=================================================
ynh_script_progression "Installing PHP $php_version extensions..."

# Install versioned PHP extensions to ensure they match the active PHP-FPM version.
# The generic 'php-zip' package in manifest.toml may install for a different PHP version.
for ext in zip gd sqlite3 curl mbstring xml intl opcache; do
    pkg="php${php_version}-${ext}"
    if ! dpkg -l "$pkg" 2>/dev/null | grep -q '^ii'; then
        apt-get install -y --no-install-recommends "$pkg" || ynh_print_info "Could not install $pkg (may already be installed under another name)"
    fi
done

# Enable extensions in PHP-FPM CLI and ensure they are active
for ext in zip gd sqlite3 curl mbstring xml intl opcache; do
    phpenmod -v "$php_version" "$ext" 2>/dev/null || true
done

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

#=================================================
# INSTALL COMPOSER DEPENDENCIES
#=================================================
ynh_script_progression "Installing Composer dependencies..."

# Check if composer.json exists before installing dependencies
if [[ -f "$install_dir/composer.json" ]]; then
    # composer.phar is provisioned by the composer resource declared in manifest.toml
    ynh_composer_exec install --no-dev --prefer-dist --optimize-autoloader
else
    ynh_print_info "No composer.json found, skipping Composer dependencies installation"
fi

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations..."

ynh_config_add_phpfpm

ynh_config_add_nginx

#=================================================
# CREATE DATA DIRECTORIES
#=================================================
ynh_script_progression "Creating data directories..."

mkdir -p "$data_dir/uploads/site"
mkdir -p "$data_dir/uploads/auteurs"
mkdir -p "$data_dir/uploads/textes"
mkdir -p "$data_dir/uploads/avatars"
mkdir -p "$data_dir/uploads/.logs"
mkdir -p "$data_dir/uploads/.ratelimit"
mkdir -p "$data_dir/backups"
mkdir -p "$data_dir/logs"
mkdir -p "$data_dir/releases"

# Set permissions on data directories first
chown -R "$app:www-data" "$data_dir"
chmod -R 750 "$data_dir"

# Remove existing directories before creating symlinks
if [[ -e "$install_dir/uploads" ]]; then
    rm -rf "$install_dir/uploads"
fi
if [[ -e "$install_dir/backups" ]]; then
    rm -rf "$install_dir/backups"
fi
if [[ -e "$install_dir/logs" ]]; then
    rm -rf "$install_dir/logs"
fi
if [[ -e "$install_dir/releases" ]]; then
    rm -rf "$install_dir/releases"
fi

# Symlink folders to data_dir for persistence
ln -sf "$data_dir/uploads" "$install_dir/uploads"
ln -sf "$data_dir/backups" "$install_dir/backups"
ln -sf "$data_dir/logs" "$install_dir/logs"
ln -sf "$data_dir/releases" "$install_dir/releases"

# Create temp migration directory
mkdir -p "$install_dir/api/temp_migration"
chown "$app:www-data" "$install_dir/api/temp_migration"
chmod 775 "$install_dir/api/temp_migration"

#=================================================
# ADD A CONFIGURATION
#=================================================
ynh_script_progression "Adding app's configuration..."

load_app_settings
render_app_config

# Remove the installer scripts for security
rm -f "$install_dir/install.php" "$install_dir/install_app.php"

#=================================================
# IMPORT DATABASE
#=================================================
ynh_script_progression "Importing database..."

if [[ -f "$install_dir/sql/database_numerique.sql" ]]; then
    ynh_mysql_db_shell < "$install_dir/sql/database_numerique.sql"
else
    ynh_die "Database schema file not found: $install_dir/sql/database_numerique.sql"
fi

# The upstream SQL uses legacy Font Awesome class names such as fa-home.
# Normalize them for the locally bundled Font Awesome stylesheet.
normalize_menu_icons

#=================================================
# CREATE ADMIN USER
#=================================================
ynh_script_progression "Creating admin user..."

if ynh_in_ci_tests && [[ ${#admin_password} -lt 8 ]]; then
    admin_password="yunohost_ci_admin_pass1234"
fi

if [[ -z "${admin_password:-}" || ${#admin_password} -lt 8 ]]; then
    ynh_die "The administrator password must be defined and contain at least 8 characters."
fi

if [ -z "${admin_email:-}" ]; then
    admin_email=$(ynh_user_get_info --username="$admin" --key=mail 2>/dev/null || ynh_user_get_info --username="$admin" --key=email 2>/dev/null || true)
    admin_email="${admin_email:-${admin}@${domain}}"
fi

hashed_password=$(php"$php_version" -r 'echo password_hash($argv[1], PASSWORD_DEFAULT);' "$admin_password")
admin_sql=$(php_escape "$admin")
admin_email_sql=$(php_escape "$admin_email")
hashed_password_sql=$(php_escape "$hashed_password")

# Escape all values before passing them to the SQL client. The password itself
# is never written to the logs or inserted in clear text.
ynh_mysql_db_shell <<EOF
INSERT INTO utilisateur (nom, prenom, mel, motpasse, role, dateinscription)
VALUES ('${admin_sql}', 'Admin', '${admin_email_sql}', '${hashed_password_sql}', 'admin', NOW());
EOF

#=================================================
# SET PERMISSIONS
#=================================================
ynh_script_progression "Setting permissions..."

chown -R "$app:www-data" "$install_dir"
chmod -R 750 "$install_dir"

chmod 400 "$install_dir/includes/database.php" "$install_dir/includes/config.php"
chown "$app:$app" "$install_dir/includes/database.php" "$install_dir/includes/config.php"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Installation of $app completed"
