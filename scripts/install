#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

# Check PHP version availability
check_php_version

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

#=================================================
# INSTALL COMPOSER DEPENDENCIES
#=================================================
ynh_script_progression "Installing Composer dependencies..."

# Check if composer.json exists before installing dependencies
if [[ -f "$install_dir/composer.json" ]]; then
    ynh_composer_install
else
    ynh_print_info "No composer.json found, skipping Composer dependencies installation"
fi

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations..."

ynh_config_add_phpfpm

ynh_config_add_nginx

#=================================================
# CREATE DATA DIRECTORIES
#=================================================
ynh_script_progression "Creating data directories..."

mkdir -p "$data_dir/uploads/site"
mkdir -p "$data_dir/uploads/auteurs"
mkdir -p "$data_dir/uploads/textes"
mkdir -p "$data_dir/uploads/avatars"
mkdir -p "$data_dir/backups"

# Set permissions on data directories first
chown -R "$app:www-data" "$data_dir"
chmod -R 750 "$data_dir"

# Remove existing directories before creating symlinks
if [[ -e "$install_dir/uploads" ]]; then
    rm -rf "$install_dir/uploads"
fi
if [[ -e "$install_dir/backups" ]]; then
    rm -rf "$install_dir/backups"
fi

# Symlink uploads to data_dir for persistence
ln -sf "$data_dir/uploads" "$install_dir/uploads"
ln -sf "$data_dir/backups" "$install_dir/backups"

#=================================================
# ADD A CONFIGURATION
#=================================================
ynh_script_progression "Adding app's configuration..."

# Retrieve database credentials
db_name=$(ynh_app_setting_get --key=db_name)
db_user=$(ynh_app_setting_get --key=mysql_user)
db_pwd=$(ynh_app_setting_get --key=mysql_pwd)

# Retrieve admin email early for config
admin_email=$(ynh_user_get_info --username="$admin" --key="mail")
current_date=$(date +"%Y-%m-%d %H:%M:%S")

# Create includes directory
mkdir -p "$install_dir/includes"

# Generate database.php in includes/
ynh_config_add --template="database.php" --destination="$install_dir/includes/database.php"
chmod 400 "$install_dir/includes/database.php"
chown "$app:$app" "$install_dir/includes/database.php"

# Generate config.php in includes/ to bypass installer
ynh_config_add --template="config.php" --destination="$install_dir/includes/config.php"
ynh_replace_string "__ADMIN_EMAIL__" "$admin_email" "$install_dir/includes/config.php"
ynh_replace_string "__DOMAIN__" "$domain" "$install_dir/includes/config.php"
# Clean path: remove trailing slash if present, though YunoHost $path usually has one?
# The PHP installer trims right slash. Let's ensure it's clean.
# Actually $path in YunoHost is usually / or /foo/.
clean_path=${path%/}
ynh_replace_string "__PATH__" "$clean_path" "$install_dir/includes/config.php"
ynh_replace_string "__DATE__" "$current_date" "$install_dir/includes/config.php"

chmod 644 "$install_dir/includes/config.php"
chown "$app:$app" "$install_dir/includes/config.php"

# DEBUG: Check if files exist and are not empty
ynh_print_info "DEBUG: Listing includes directory:"
ls -la "$install_dir/includes/"
if [[ ! -s "$install_dir/includes/config.php" ]]; then
    ynh_print_warn "WARNING: config.php is empty or missing!"
fi
if [[ -z "$db_pwd" ]]; then
    ynh_print_warn "WARNING: db_pwd variable is empty!"
fi
# END DEBUG

# Remove the installer scripts for security
rm -f "$install_dir/install.php" "$install_dir/install_app.php"

#=================================================
# IMPORT DATABASE
#=================================================
ynh_script_progression "Importing database..."

if [[ -f "$install_dir/database_numerique.sql" ]]; then
    ynh_mysql_db_shell < "$install_dir/database_numerique.sql"
else
    ynh_die "Database schema file not found: $install_dir/database_numerique.sql"
fi

#=================================================
# CREATE ADMIN USER
#=================================================
ynh_script_progression "Creating admin user..."

hashed_password=$(php -r "echo password_hash('$admin_password', PASSWORD_DEFAULT);")

# Use prepared statement for security
ynh_mysql_db_shell <<EOF
INSERT INTO utilisateur (nom, prenom, mel, motpasse, role, dateinscription) 
VALUES ('${admin}', 'Admin', '${admin_email}', '${hashed_password}', 'admin', NOW());
EOF

#=================================================
# SET PERMISSIONS
#=================================================
ynh_script_progression "Setting permissions..."

chown -R "$app:www-data" "$install_dir"
chmod -R 750 "$install_dir"

#=================================================
# END OF SCRIPT
#=================================================

# Display database credentials for manual setup if needed
ynh_print_warn "IMPORTANT: Si l'application vous demande de configurer la base de données, utilisez ces informations :"
ynh_print_info "Hôte : localhost"
ynh_print_info "Base de données : $db_name"
ynh_print_info "Utilisateur : $db_user"
ynh_print_info "Mot de passe : $db_pwd"

ynh_script_progression "Installation of $app completed"
