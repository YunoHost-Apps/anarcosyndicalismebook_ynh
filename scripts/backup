#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

detect_php_version || ynh_die "Unable to detect the PHP version for backup"

#=================================================
# DECLARE DATA AND CONF FILES TO BACKUP
#=================================================
ynh_print_info "Declaring files to be backed up..."

# Backup application directory
ynh_backup "$install_dir"

# Backup data directory (uploads, backups)
ynh_backup "$data_dir"

# Backup nginx configuration
ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"

# Backup PHP-FPM configuration
ynh_backup "/etc/php/$php_version/fpm/pool.d/$app.conf"

#=================================================
# BACKUP THE MYSQL DATABASE
#=================================================
ynh_print_info "Backing up the MySQL database..."

# Create database backup with error handling
if ! ynh_mysql_dump_db > db.sql; then
    ynh_die "Failed to backup database"
fi

# Verify backup file was created and is not empty
if [[ ! -s "db.sql" ]]; then
    ynh_die "Database backup file is empty or was not created"
fi

#=================================================
# END OF SCRIPT
#=================================================
ynh_print_info "Backup of $app completed"
